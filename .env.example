# Copy this file to .env and fill in your keys

# --- LLM provider (pick ONE) ---
# Gemini is FREE, no credit card needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic is paid but higher quality - only needed if you'd rather use it.
# If both are set, GEMINI_API_KEY takes priority.
ANTHROPIC_API_KEY=

# Adzuna job search API (free tier: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: comma-separated list of Greenhouse company board tokens
# Find a company's token from their careers page URL, e.g.
# https://boards.greenhouse.io/stripe -> token is "stripe"
GREENHOUSE_BOARDS=stripe,airbnb,figma,notion,doordash

# Optional: comma-separated list of Lever company slugs
# e.g. https://jobs.lever.co/netflix -> slug is "netflix"
LEVER_BOARDS=netflix,palantir

# SQLite DB path (default is fine for local/dev)
DATABASE_URL=sqlite:///./placements.db

# --- Auth ---
# Secret used to sign JWT login tokens. Generate a real one for deploy:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=30

# Your deployed app's URL (no trailing slash) - used to build the link
# inside password-reset emails. Leave blank for local dev (localhost).
# Example: FRONTEND_BASE_URL=https://waypost.onrender.com
FRONTEND_BASE_URL=

# --- Email notifications (Resend HTTP API) ---
# Render's free tier (and several other hosts) block outbound SMTP ports
# entirely, so this app sends email via Resend's HTTPS API instead of
# smtplib - no port-blocking issue, since it's a normal HTTPS request.
# Get a free key at https://resend.com (API Keys -> Create API Key).
# No domain/card needed to start: the default sender below only works
# when sending TO the email address you signed up to Resend with -
# verify your own domain later (Domains tab) to send to any address.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# --- Telegram notifications ---
# Create a bot via @BotFather on Telegram, paste the token it gives you.
# Each user then links their own chat_id via POST /notifications/telegram/link
TELEGRAM_BOT_TOKEN=
